# Local CMake build. This also holds fetched dependencies, the compiled
# editor, and the tileset archives used while running Galaxy Editor.
/build/
/build-windows/
*.deb

# Tileset archives fetched for portable packages. They ship in GitHub
# releases and are not source.
*.hpi
/GalaxyEditor-*/
/GalaxyEditor-*.tar.gz
/GalaxyEditor-*.zip
/GalaxyEditor-*.dmg

# macOS Finder metadata
.DS_Store

# Window layout saved while the editor is running
imgui.ini

# Per-user CMake presets
CMakeUserPresets.json
